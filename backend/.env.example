# ─── Google Gemini ────────────────────────────────────────────────────────────
# Obter em: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=sua_chave_aqui

# ─── JWT ──────────────────────────────────────────────────────────────────────
# Usado para assinar e verificar tokens de autenticação.
# Gerar uma chave segura: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=troque_por_uma_chave_secreta_longa

# ─── Banco de dados (opcional) ────────────────────────────────────────────────
# Por padrão o banco é criado em backend/dilexy.db automaticamente.
# Só defina se quiser usar outro caminho ou PostgreSQL em produção.
# DATABASE_URL=sqlite:///caminho/absoluto/dilexy.db
# DATABASE_URL=postgresql://user:password@localhost:5432/dilexy
