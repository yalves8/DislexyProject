# In development, leave VITE_API_URL unset — requests go through the Vite proxy.
# In production, set this to your deployed backend URL (no /api suffix).
# VITE_API_URL=https://your-backend-domain.com

# Optional: enables "Entrar com Google" / "Criar conta com Google".
# Use the same value in backend/.env as GOOGLE_CLIENT_ID.
# VITE_GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com
